# Porta da API NestJS
PORT=12342

# Token mestre para autenticação estática rápida (mínimo 16 caracteres)
SYNC_TOKEN=fury_secret_token_123456789_seguro

# Chave secreta para assinar e validar os tokens JWT
JWT_SECRET=fury_super_jwt_secret_dev_key_12345

# Credenciais e conexão S3 / MinIO
S3_ENDPOINT=http://minio:9000
# Altere para o IP público da sua VPS para os uploads funcionarem remotamente
# Exemplo: http://123.45.67.89:8987 ou https://s3.seusite.com
S3_PUBLIC_ENDPOINT=http://localhost:8987
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=furyadmin
S3_SECRET_ACCESS_KEY=furypassword123
S3_BUCKET=fury-sync
S3_FORCE_PATH_STYLE=true
